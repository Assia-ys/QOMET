{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "cd frontend/src && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "uvicorn backend.main:socket_app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
